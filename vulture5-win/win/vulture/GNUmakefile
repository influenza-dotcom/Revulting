#        Vulture Makefile

ifdef VARIANT_NAME
ifdef VARIANT_VERSION

ifndef CXX
	CXX := g++
endif

LD := ld

ifndef SDL_CFLAGS
	ifndef SDL_CONFIG
		OS := $(shell uname -s)
		SDL_CONFIG := sdl2-config
	endif
	# NB: sdl2-config on Windows emits -Dmain=SDL_main, which would rename
	# NetHack's main(). We keep NetHack's own main() (windmain.c) and set
	# SDL_MAIN_HANDLED instead, so that define must be filtered out.
	SDL_CFLAGS = $(filter-out -Dmain=SDL_main,$(shell $(SDL_CONFIG) --cflags)) $(shell pkg-config --cflags libpng 2>/dev/null)
endif

CFLAGS := $(BASECFLAGS) $(SDL_CFLAGS) -DUSE_SDL_SYSCALLS -g3 -Wall

VARIANT_VERSION_CLEANED := $(shell echo $(VARIANT_VERSION)|tr . _)
BUILDDIR := build_$(VARIANT_NAME)_$(VARIANT_VERSION_CLEANED)
VARIANT_NAME_UPPER := $(shell echo $(VARIANT_NAME)|tr a-z A-Z)
CFLAGS += -DVULTURE_$(VARIANT_NAME_UPPER)
CFLAGS += -DVULTURE_$(VARIANT_NAME_UPPER)_$(VARIANT_VERSION_CLEANED)


# build target
OUTPUT_OBJ := $(BUILDDIR)/vulture.o


NHDIR := ../..
NHSRC := $(NHDIR)/src
INCLUDE := -I $(NHDIR)/include/  -I . -I $(BUILDDIR)/ -I $(NHDIR)/sys/windows/

# list of sources. list of objects and dependency files are autogenerated from it
VSOURCES := $(wildcard *.cpp) $(wildcard winclass/*.cpp)
VOBJ := $(patsubst %.cpp,$(BUILDDIR)/%.o, $(VSOURCES))
VDEPS := $(subst .o,.d, $(VOBJ))

VSOURCES += $(BUILDDIR)/vulture_tileconfig.parser.cpp $(BUILDDIR)/vulture_tileconfig.lexer.cpp
VOBJ += $(BUILDDIR)/vulture_tileconfig.parser.o $(BUILDDIR)/vulture_tileconfig.lexer.o


# how to genereate dependency info
#
# NOTE the $(notdir): "gcc -MM" always emits a BASENAME target ("inventory.o:"),
# but $* here is the pattern stem, which for winclass sources is a PATH
# ("winclass/inventory").  The old sed therefore searched for
# "winclass/inventory\.o" in a file that only ever said "inventory.o", silently
# matched nothing, and left every winclass .d file naming a target
# ("inventory.o") that nothing in this makefile depends on.  Net effect: header
# changes never rebuilt any winclass object.  That is not a cosmetic problem -
# editing a class's .h and rebuilding produced a binary in which some
# translation units saw the old member layout and some the new, i.e. silent ODR
# corruption at runtime.  (The top-level sources were unaffected: for those the
# stem has no directory part, so the old expression happened to match.)
define gendeps
	@mkdir -p $(BUILDDIR)/winclass
	@set -e; rm -f $@; \
	 $(CXX) -MM $(CFLAGS) $(INCLUDE) $< > $@.$$$$; \
	 sed 's,\($(notdir $*)\)\.o[ :]*,$(BUILDDIR)/$*.o $@ : ,g' < $@.$$$$ > $@; \
	 rm -f $@.$$$$
endef


.PHONY : all
all: $(OUTPUT_OBJ)
	@echo finished building the files for the vulture interface

UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
	PARTIAL_LINK_FLAGS := -nostdlib -Xlinker -r -lc++
else ifneq (,$(findstring MINGW,$(UNAME_S)))
	# mingw-w64: -no-pie is a Linux-only gcc driver flag
	PARTIAL_LINK_FLAGS := -nostdlib -Xlinker -r -lstdc++
else ifneq (,$(findstring MSYS,$(UNAME_S)))
	PARTIAL_LINK_FLAGS := -nostdlib -Xlinker -r -lstdc++
else
	PARTIAL_LINK_FLAGS := -nostdlib -no-pie -Xlinker -r -lstdc++
endif

# NetHack's Windows (mingw) makefile does not generate include/date.h - only the
# unix path does - but vulture_sdl.cpp wants VERSION_ID from it for the window
# title. Generate a minimal one into BUILDDIR (already on the include path).
VULTURE_DATE_H := $(BUILDDIR)/date.h
$(VULTURE_DATE_H):
	@mkdir -p $(BUILDDIR)/winclass
	@echo '/* generated by win/vulture/GNUmakefile - do not edit */' > $@
	@echo '#ifndef VERSION_ID' >> $@
	@echo '#define VERSION_ID "NetHack 5.0.0 (Vulture) - built '"`date`"'"' >> $@
	@echo '#endif' >> $@

$(VOBJ): $(VULTURE_DATE_H)

$(OUTPUT_OBJ): $(VOBJ)
	@echo combining objects to $@
	@$(CXX) $(PARTIAL_LINK_FLAGS) $(VOBJ) -o $(OUTPUT_OBJ)

$(BUILDDIR)/vulture_tileconfig.parser.cpp $(BUILDDIR)/vulture_tileconfig.parser.h: vulture_tileconfig.parser.y
	@echo generating parser
	@mkdir -p $(BUILDDIR)/winclass
	@bison -d vulture_tileconfig.parser.y -o $(BUILDDIR)/vulture_tileconfig.parser.c
	@mv $(BUILDDIR)/vulture_tileconfig.parser.c $(BUILDDIR)/vulture_tileconfig.parser.cpp

$(BUILDDIR)/vulture_tileconfig.lexer.cpp: vulture_tileconfig.lexer.l
	@echo generating lexer
	@mkdir -p $(BUILDDIR)/winclass
	@flex -o $@ $<

# Path A (ASCII minimap) remap: patha/remap_table.h is a GENERATED, COMMITTED,
# deterministic artifact (NetHack 5.0.0 tile index -> Vulture atlas cell / placeholder),
# produced from the hand-edited patha/remap.manifest.json by patha/validate.py, which
# emits it only after all checks pass. Normal builds use the committed header; run
# 'make patha-remap' to regenerate it when the manifest changes (needs python3 and the
# pinned NetHack 5.0.0/3.6.6/3.6.0 metadata trees). Any source that #includes it (Phase 4)
# picks up the header via the auto-generated per-object dependencies.
PATHA_MANIFEST := patha/remap.manifest.json
PATHA_REMAP := patha/remap_table.h
.PHONY: patha-remap
patha-remap: $(PATHA_MANIFEST) patha/validate.py
	@echo regenerating Path A remap header from $(PATHA_MANIFEST)
	@cd patha && python3 validate.py --emit

# including the dependency files will cause them to be built if they don't exist
-include $(VDEPS)

#dependency for $(BUILDDIR)/vulture_tileconfig.lexer.o must be given explicitly as it is not autogenerated
$(BUILDDIR)/vulture_tileconfig.lexer.o : $(BUILDDIR)/vulture_tileconfig.parser.h

# this dependency is necessary for parallel make to work: otherwise bison might
# be called twice and the 2 invocations will race
$(BUILDDIR)/vulture_tileconfig.parser.h : $(BUILDDIR)/vulture_tileconfig.parser.cpp

# additionally, all our objects depend on the Makefile:
$(VOBJ): GNUmakefile

# rules to generate the dependencies using the gendeps macro
$(BUILDDIR)/%.d: %.cpp
	$(gendeps)

# this will cause all regular files to be built
# NOTE: this rule will match for ../nethack/src/monst.c -> ../nethack/src/monst.o
#       too, if necessary. Normally monst.o will already exist when we get here,
#       but it may be useful when testing tiletrans...
%.o $(BUILDDIR)/%.o: %.cpp
	@echo compiling $<
	@mkdir -p $(BUILDDIR)/winclass
	echo `pwd`
	$(CXX) $(CFLAGS) $(INCLUDE) -c $< -o $@
	

else # VARIANT_VERSION not defined
.PHONY:all
all:
	@echo "you must invoke this makefile with VARIANT_NAME=(nethack|slashem|...) VARIANT_VERSION=(3.4.3|3.6.0|...)"
	@echo "so that we can find our includes..."
	@echo "you may also give additional parameters such as CFLAGS= etc"
endif
else # VARIANT_NAME not defined
.PHONY:all
all:
	@echo "you must invoke this makefile with VARIANT_NAME=(nethack|slashem|...) VARIANT_VERSION=(3.4.3|3.6.0|...)"
	@echo "so that we can find our includes..."
	@echo "you may also give additional parameters such as CFLAGS= etc"
endif


.PHONY:
clean:
	rm -rf build_*
